# =====================================================================
# Personal Intelligence — Environment Configuration Template
# =====================================================================

# =====================================================================
# A. PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# ---------------------------------------------------------------------
# 1. Supabase Production Infrastructure
# ---------------------------------------------------------------------
# Public client credentials (safe to expose to browser bundle via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Production Application Root URL (Used for OAuth redirects and canonical links)
NEXT_PUBLIC_APP_URL="https://your-app-domain.vercel.app"

# Server-side direct database connection (optional if using Supabase Data API)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# CRITICAL SECURITY RULE: NEVER EXPOSE SUPABASE_SERVICE_ROLE_KEY TO BROWSER BUNDLE
# Used strictly server-side by backend ingestion workers and cron jobs to bypass RLS
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ---------------------------------------------------------------------
# 2. Google Cloud OAuth (Configured in Supabase Auth Dashboard)
# ---------------------------------------------------------------------
# Configure in Supabase Auth -> Providers -> Google using values from Google Cloud Console:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---------------------------------------------------------------------
# 3. Scheduled Worker & Production Cron Authentication
# ---------------------------------------------------------------------
# Secret token required to trigger /api/cron/*, /api/ingest, and /api/ai/process
# Set this in Vercel environment variables as CRON_SECRET
CRON_SECRET="your-random-strong-cron-secret-token"

# ---------------------------------------------------------------------
# 4. Google Gemini AI Configuration (Free Tier Optimized)
# ---------------------------------------------------------------------
# CRITICAL SECURITY RULE: NEVER EXPOSE GEMINI_API_KEY TO BROWSER BUNDLE
# Must be set strictly server-side
GEMINI_API_KEY="your-gemini-api-key"

# Model Selection
GEMINI_FLASH_LITE_MODEL="gemini-flash-lite-latest"
GEMINI_FLASH_MODEL="gemini-flash-latest"

# AI Pipeline Flags & Quota Protections
AI_ENABLED=true
AI_DEEP_ANALYSIS_ENABLED=true
AI_IMPORTANT_THRESHOLD=0.7
AI_BATCH_SIZE=10
AI_CONCURRENCY=2
AI_MAX_RETRIES=1
AI_PROMPT_VERSION=2

# ---------------------------------------------------------------------
# 5. News Ingestion Providers
# ---------------------------------------------------------------------
# GDELT Ingestion Provider
GDELT_API_URL="https://api.gdeltproject.org/api/v2/doc/doc"
GDELT_TIMEOUT_MS=12000
GDELT_RATE_LIMIT_MS=5100

# RSS Ingestion Provider
RSS_FEEDS="https://feeds.bbci.co.uk/news/world/rss.xml, https://techcrunch.com/feed/"
RSS_TIMEOUT_MS=10000
RSS_CONCURRENCY=3

# ---------------------------------------------------------------------
# 6. Rate Limiting & System Safety
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000

# =====================================================================
# B. LOCAL DEVELOPMENT CONFIGURATION (OVERRIDE IN .env.local)
# =====================================================================
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="local-anon-key"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# SUPABASE_SERVICE_ROLE_KEY="local-service-role-key"
# CRON_SECRET="dev-cron-secret-local-testing"
# GEMINI_API_KEY="your-local-gemini-key"
