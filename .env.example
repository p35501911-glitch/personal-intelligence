# =====================================================================
# Personal Intelligence — Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# 1. Supabase Infrastructure (Production & Development)
# ---------------------------------------------------------------------
# Public client credentials (safe to expose to browser bundle via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-side direct database connection (optional if using Supabase Data API)
DATABASE_URL="postgresql://postgres:password@localhost:5432/personal_intelligence?schema=public"

# CRITICAL SECURITY RULE: NEVER EXPOSE SUPABASE_SERVICE_ROLE_KEY TO BROWSER
# Used strictly server-side by backend ingestion workers to bypass RLS
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ---------------------------------------------------------------------
# 2. Google OAuth (Configured in Supabase Auth Dashboard)
# ---------------------------------------------------------------------
# In Supabase Auth, configure Google provider under Authentication -> Providers -> Google.
# Client ID and Client Secret from Google Cloud Console:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---------------------------------------------------------------------
# 3. Scheduled Worker & Cron Security
# ---------------------------------------------------------------------
# Secret token required to trigger /api/ingest, /api/ai/process, and batch /api/digests/generate
# Set this in Vercel / hosting environment variables to secure scheduled tasks
CRON_SECRET="your-random-strong-cron-secret-token"

# ---------------------------------------------------------------------
# 4. Google Gemini AI Configuration (Free Tier Optimized)
# ---------------------------------------------------------------------
# CRITICAL SECURITY RULE: NEVER EXPOSE GEMINI_API_KEY TO BROWSER BUNDLE
# Must be set strictly server-side
GEMINI_API_KEY="your-gemini-api-key"

# Model Selection
GEMINI_FLASH_LITE_MODEL="gemini-flash-lite-latest"
GEMINI_FLASH_MODEL="gemini-flash-latest"

# AI Pipeline Flags & Quota Protections
AI_ENABLED=true
AI_DEEP_ANALYSIS_ENABLED=true
AI_IMPORTANT_THRESHOLD=0.7
AI_BATCH_SIZE=10
AI_CONCURRENCY=2
AI_MAX_RETRIES=1
AI_PROMPT_VERSION=2

# ---------------------------------------------------------------------
# 5. News Ingestion Providers
# ---------------------------------------------------------------------
# GDELT Ingestion Provider
GDELT_API_URL="https://api.gdeltproject.org/api/v2/doc/doc"
GDELT_TIMEOUT_MS=12000
GDELT_RATE_LIMIT_MS=5100

# RSS Ingestion Provider
# Optional: comma-separated URLs or JSON array of feed objects. If omitted, default curated feeds are used.
RSS_FEEDS="https://feeds.bbci.co.uk/news/world/rss.xml, https://techcrunch.com/feed/"
RSS_TIMEOUT_MS=10000
RSS_CONCURRENCY=3
