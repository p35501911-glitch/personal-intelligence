{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ingestion",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ai",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/digests?periodType=daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digests?periodType=weekly",
      "schedule": "0 6 * * 1"
    }
  ]
}
